# Copia este archivo a .env.local y llena los valores reales.
# NUNCA pongas valores reales aquí ni los hardcodees en el código -- ver el
# incidente de seguridad 2026-08-01 en docs/AGENT_CONTEXT_ANTIGRAVITY.md
# (11 llaves de Supabase encontradas hardcodeadas en scripts/).

# ── Supabase (simoOS-prod) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para Server Actions / scripts de servidor -- NUNCA en componentes de
# cliente ni en el navegador. Ver lib/database.ts.
SUPABASE_SERVICE_ROLE_KEY=
# Referencia del proyecto (la parte antes de .supabase.co en la URL), usada
# por algunos scripts/ para armar links del dashboard.
SUPABASE_PROJECT_REF=

# ── Prisma / Postgres directo ───────────────────────────────────────────────
DATABASE_URL=

# ── Cifrado HR Vault (lib/security/hr-vault.ts, token-vault.ts) ─────────────
TOKEN_VAULT_KEY=

# ── Redis (colas/caché de PMO) ───────────────────────────────────────────────
REDIS_URL=

# ── BigQuery (carga centralizada de RRHH -> lib/bigquery/client.ts) ─────────
# Contenido completo del .json de la cuenta de servicio de Google Cloud,
# pegado como un solo string. Proyecto: mcp-connector-procedure.
GOOGLE_CLOUD_CREDENTIALS_JSON=
