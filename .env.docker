# ─────────────────────────────────────────────────────────────────────────────
# SIMO Intellisense — Variables de Entorno para Docker Local
# ¡NO COMMITEAR ESTE ARCHIVO! Añadir a .gitignore si no está ya
# Para producción, usar variables de entorno de Vercel + Supabase + Upstash
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL Local (docker-compose) ────────────────────────────────────────
POSTGRES_USER=simo_dev
POSTGRES_PASSWORD=simo_dev_secret_change_in_prod
POSTGRES_DB=simo_intellisense
POSTGRES_PORT=5433

# Connection string para uso directo (ej. desde scripts de migración locales)
DATABASE_URL=postgresql://simo_dev:simo_dev_secret_change_in_prod@localhost:5433/simo_intellisense

# ── Redis Local (docker-compose) ──────────────────────────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Redis Commander UI (solo dev-tools profile)
REDIS_UI_PORT=8081

# ── BullMQ Queues (Sprint 2+ — motor de frecuencias PMO) ─────────────────────
# Nota: En producción reemplazar con Upstash Redis URL (con TLS)
BULLMQ_REDIS_URL=redis://localhost:6380
BULLMQ_PREFIX=simo_pmo

# Queue names (deben coincidir con los workers del backend)
QUEUE_PLAYBOOK_PROCESSOR=pmo:playbook-processor
QUEUE_FREQUENCY_ENGINE=pmo:frequency-engine
QUEUE_MIRROR_SYNC=pmo:mirror-sync
QUEUE_SECURITY_EVENTS=pmo:security-events

# ── Simo IS Integration (Sprint 3) ───────────────────────────────────────────
# HMAC-SHA256 secret para validar requests de Simo IS
# Generar con: openssl rand -hex 32
SIMO_IS_HMAC_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
SIMO_IS_ENDPOINT=https://app.simo-is.com/api
SIMO_SSO_ENABLED=false

# ── JWT (Sprint 2) ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
