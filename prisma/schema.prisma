generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PmoTask {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  boardId              String    @map("board_id")
  groupId              String    @map("group_id")
  title                String
  description          String?
  dueDate              DateTime? @map("due_date")
  priority             String?
  status               String    @default("not_started")
  isProtected          Boolean   @default(false) @map("is_protected")
  sourcePlaybookId     String?   @map("source_playbook_id")
  sourcePlaybookTaskId String?   @map("source_playbook_task_id")
  occurrenceIndex      Int?      @map("occurrence_index")
  position             Int       @default(0)
  customFieldValues    Json      @map("custom_field_values")
  itemHeight           String    @default("simple") @map("item_height")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  completedAt          DateTime? @map("completed_at")
  timeSpentMinutes     Int?      @map("time_spent_minutes")

  // Salesforce & External Connectivity
  externalId           String?   @map("external_id")
  externalUrl          String?   @map("external_url")
  metadata             Json?     @map("metadata")

  activityLogs         PmoActivityLog[]
  securityEvents       PmoSecurityEvent[]

  @@index([orgId])
  @@index([boardId])
  @@map("pmo_tasks")
}

model PmoActivityLog {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  taskId      String   @map("task_id")
  userId      String   @map("user_id")
  actionType  String   @map("action_type")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at")

  task        PmoTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([taskId])
  @@map("pmo_activity_logs")
}

model PmoSecurityEvent {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  userId      String   @map("user_id")
  taskId      String   @map("task_id")
  attemptedAt DateTime @default(now()) @map("attempted_at")
  ipAddress   String   @map("ip_address")
  vector      String
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  task        PmoTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([taskId])
  @@map("pmo_security_events")
}

model PmoEvent {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  title                String
  description          String?
  startDateTime        DateTime  @map("start_date_time")
  endDateTime          DateTime  @map("end_date_time")
  
  // External Connectivity
  externalId           String?   @map("external_id")
  externalUrl          String?   @map("external_url")
  metadata             Json?     @map("metadata")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("pmo_events")
}

model UserIntegration {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  userId               String    @map("user_id")
  provider             String    // 'salesforce', 'outlook', 'zoom'
  providerUserId       String    @map("provider_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([orgId, userId, provider])
  @@map("pmo_user_integrations")
}

model IntegrationToken {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  userId               String    @map("user_id")
  provider             String    // 'salesforce', 'outlook', 'zoom'
  accessToken          String    @map("access_token")
  refreshToken         String?   @map("refresh_token")
  scopes               String[]  @default([])
  isActive             Boolean   @default(true) @map("is_active")
  expiresAt            DateTime? @map("expires_at")
  metadata             Json?     @map("metadata")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([orgId, userId, provider])
  @@map("pmo_integration_tokens")
}

// ─── Mirror Sync Protocol (Llave #4) ─────────────────────────────────────────
// Maps every PMO entity to its counterpart in Salesforce / Outlook / Zoom.
// Coexists with pmo_sync_events (conflict log); this table is the persistent mapping.

model PmoSyncMapping {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  pmoEntityType     String   @map("pmo_entity_type")   // "TASK" | "EVENT" | "NOTE"
  pmoEntityId       String   @map("pmo_entity_id")     // ID of the PMO task/event
  provider          String                              // "SALESFORCE" | "OUTLOOK" | "ZOOM"
  externalId        String   @map("external_id")        // SF Task ID / SF Event ID
  externalUrl       String?  @map("external_url")       // deep link to the object in SF
  lastSyncDirection String   @map("last_sync_direction") // "PMO_TO_EXT" | "EXT_TO_PMO" | "CONFLICT"
  lastSyncAt        DateTime @map("last_sync_at")
  syncStatus        String   @default("OK") @map("sync_status") // "OK"|"PENDING"|"ERROR"|"CONFLICT"
  conflictData      Json?    @map("conflict_data")      // snapshot for manual resolution
  metadata          Json?    @map("metadata")            // join_url Zoom, meeting_id, zoomEventId
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([pmoEntityId, provider])
  @@index([provider, externalId])
  @@index([orgId])
  @@map("pmo_sync_mappings")
}

model Organization {
  id                   String      @id @default(uuid())
  name                 String
  countryCode          String      @default("US") @map("country_code")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  playbooks            BpPlaybook[]

  @@map("organizations")
}

// ─── Business Plan: Playbook Designer ────────────────────────────────────────

model BpPlaybook {
  id               String          @id @default(uuid())
  orgId            String          @map("org_id")
  name             String
  type             String          @default("GROWTH")      // CORE | GROWTH | ELITE
  family           String          @default("COMMERCIAL")  // COMMERCIAL | OPERATIONAL
  strategy         String          @default("B2B")         // B2B | B2C | NPPM
  purpose          String?
  status           String          @default("DRAFT")       // DRAFT | SUBMITTED
  globalOwners     String[]        @map("global_owners")   // Array of role names
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  steps            BpPlaybookStep[]

  @@index([orgId])
  @@map("bp_playbooks")
}

model BpPlaybookStep {
  id                       String     @id @default(uuid())
  orgId                    String     @map("org_id")           // Multi-tenant filter
  playbookId               String     @map("playbook_id")
  uid                      String                              // Business UID e.g. "HBT032"
  stepNum                  String     @map("step_num")         // "01", "02", ...
  name                     String                              // UPPERCASE activity name
  typeOfActivity           String?    @map("type_of_activity") // CALL | EMAIL | ...
  purpose                  String?
  activityDescription      String?    @map("activity_description")
  deliverable              String?                             // UPPERCASE output
  deliverableDescription   String?    @map("deliverable_description")
  stakeholder              String?                             // UPPERCASE role
  frequency                String     @default("DAILY")        // DAILY | WEEKLY | MONTHLY | YEARLY
  repetitions              Int        @default(1)
  freqNotes                String?    @map("freq_notes")
  schedulerValue           Int        @default(0) @map("scheduler_value") // Workday offset (WorkdayHelper Llave #2)
  supportingTask           String?    @map("supporting_task")  // UPPERCASE counteraction
  counteractionDescription String?    @map("counteraction_description")
  requestedTo              String?    @map("requested_to")     // Employee ID
  sla                      String?                             // UPPERCASE success metric
  slaDescription           String?    @map("sla_description")
  isLocked                 Boolean    @default(false) @map("is_locked")     // Shield Protocol
  isRepeatable             Boolean    @default(false) @map("is_repeatable") // Library membership
  position                 Int        @default(0)              // Sort order
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  playbook                 BpPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([playbookId])
  @@map("bp_playbook_steps")
}

model User {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  email                String    @unique
  name                 String?
  countryCode          String    @default("CO") @map("country_code")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("users")
}

// ─── HR Module ────────────────────────────────────────────────────────────────
// Llave #3: isLocked = true means the record is IMMUTABLE (Shield Protocol)
// Llave #4: All salary / ID fields are AES-256-GCM encrypted (HR Vault)
// Llave #1: Every query MUST filter by orgId (multi-tenant isolation)

model HrEmployee {
  id                    String                @id @default(uuid())
  orgId                 String                @map("org_id")
  eid                   String                @unique            // EID-0042
  status                String                @default("Active") // Active | Inactive | On Leave | Terminated
  emailCorporate        String?               @map("email_corporate")
  photoUrl              String?               @map("photo_url")

  // Encrypted identity (AES-256-GCM via lib/security/hr-vault.ts)
  identificacionEnc     String                @map("identificacion_enc")
  tipoDocumento         String                @map("tipo_documento")
  primerNombre          String                @map("primer_nombre")
  otrosNombres          String?               @map("otros_nombres")
  primerApellido        String                @map("primer_apellido")
  segundoApellido       String                @map("segundo_apellido")
  fechaNacimiento       String                @map("fecha_nacimiento") // ISO date
  genero                String                @db.Char(1)
  emailPersonal         String                @map("email_personal")
  municipioDane         String                @map("municipio_dane")
  direccionResidencia   String                @map("direccion_residencia")

  // Geography
  continentId           String?               @map("continent_id")
  countryId             String?               @map("country_id")
  cityId                String?               @map("city_id")
  salaryCurrencyCode    String                @default("COP") @map("salary_currency_code")

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  contracts             HrContract[]
  payrollPeriods        HrPayroll[]
  vacationRequests      HrVacationRequest[]
  performanceReviews    HrPerformanceReview[]

  @@index([orgId])
  @@index([eid])
  @@map("hr_employees")
}

model HrContract {
  id                    String      @id @default(uuid())
  orgId                 String      @map("org_id")
  employeeId            String      @map("employee_id")
  fechaInicio           String      @map("fecha_inicio")  // ISO date
  fechaFin              String?     @map("fecha_fin")     // null = current
  tipoContrato          String      @map("tipo_contrato")
  tipoSalario           String      @map("tipo_salario")

  // Encrypted salary (AES-256-GCM)
  salarioBaseEnc        String      @map("salario_base_enc")
  salaryCurrencyCode    String      @default("COP") @map("salary_currency_code")

  procedimientoRenta    Int         @default(1) @map("procedimiento_renta")
  entidadLegal          String?     @map("entidad_legal")
  area                  String
  subArea               String      @map("sub_area")
  centroCosto           String      @map("centro_costo")
  nombreCentroCosto     String?     @map("nombre_centro_costo")
  branch                String?
  cliente               String?
  project               String?
  digitoDedicacion      Int         @default(100) @map("digito_dedicacion")
  directLeaderId        String?     @map("direct_leader_id")
  jobTitle              String?     @map("job_title")

  // Shield Protocol — signed contracts are immutable
  isLocked              Boolean     @default(false) @map("is_locked")

  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  employee              HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPeriods        HrPayroll[]

  @@index([orgId])
  @@index([employeeId])
  @@map("hr_contracts")
}

model HrPayroll {
  id                    String      @id @default(uuid())
  orgId                 String      @map("org_id")
  employeeId            String      @map("employee_id")
  contractId            String      @map("contract_id")
  periodLabel           String      @map("period_label")  // "2026-03"
  periodStart           DateTime    @map("period_start")
  periodEnd             DateTime    @map("period_end")

  // WorkdayHelper — computed via lib/hr/payroll-calculator.ts
  workedDaysCount       Int         @default(0) @map("worked_days_count")
  vacationDaysDeducted  Int         @default(0) @map("vacation_days_deducted")

  // Encrypted amounts (AES-256-GCM)
  baseAmountEnc         String      @map("base_amount_enc")
  totalGrossEnc         String      @map("total_gross_enc")
  deductionsEnc         String      @map("deductions_enc")  // JSON: {health, pension, arl}
  netPayEnc             String      @map("net_pay_enc")
  currencyCode          String      @default("COP") @map("currency_code")

  // Shield Protocol — processed payrolls are immutable
  isLocked              Boolean     @default(false) @map("is_locked")
  processedAt           DateTime?   @map("processed_at")
  processedBy           String?     @map("processed_by")

  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  employee              HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contract              HrContract  @relation(fields: [contractId], references: [id])

  @@unique([orgId, employeeId, periodLabel])
  @@index([orgId])
  @@index([employeeId])
  @@map("hr_payroll_periods")
}

model HrVacationRequest {
  id                    String      @id @default(uuid())
  orgId                 String      @map("org_id")
  employeeId            String      @map("employee_id")
  requestDate           DateTime    @default(now()) @map("request_date")
  startDate             DateTime    @map("start_date")
  endDate               DateTime    @map("end_date")

  // WorkdayHelper — computed via lib/hr/vacation-calculator.ts
  calendarDays          Int         @default(0) @map("calendar_days")
  workdayDays           Int         @default(0) @map("workday_days")
  holidaysSkipped       Int         @default(0) @map("holidays_skipped")

  status                String      @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approvedById          String?     @map("approved_by_id")
  approvedAt            DateTime?   @map("approved_at")
  notes                 String?

  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  employee              HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([employeeId])
  @@map("hr_vacation_requests")
}

model HrPerformanceReview {
  id                    String      @id @default(uuid())
  orgId                 String      @map("org_id")
  employeeId            String      @map("employee_id")
  reviewerId            String      @map("reviewer_id")
  reviewPeriod          String      @map("review_period")  // "Q1-2026"
  reviewDate            DateTime    @map("review_date")

  // Scoring (0.0 – 5.0)
  scoreDelivery         Float       @default(0) @map("score_delivery")
  scoreAttitude         Float       @default(0) @map("score_attitude")
  scoreCollaboration    Float       @default(0) @map("score_collaboration")
  scoreInnovation       Float       @default(0) @map("score_innovation")
  scoreOverall          Float       @default(0) @map("score_overall") // weighted avg

  strengthsNotes        String?     @map("strengths_notes")
  improvementNotes      String?     @map("improvement_notes")
  nextGoals             String?     @map("next_goals")

  status                String      @default("DRAFT") // DRAFT | SUBMITTED | ACKNOWLEDGED

  // Shield Protocol — acknowledged reviews are immutable
  isLocked              Boolean     @default(false) @map("is_locked")

  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  employee              HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([employeeId])
  @@map("hr_performance_reviews")
}

model PmoIcalFeedToken {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  orgId        String    @map("org_id")
  token        String    @unique @default(uuid())
  isActive     Boolean   @default(true) @map("is_active")
  lastAccessAt DateTime? @map("last_access_at")
  filters      Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@map("pmo_ical_feed_tokens")
}

// ─── My Queue Notifications ────────────────────────────────────────────────────

model SimoNotification {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  userId          String    @map("user_id")
  type            String
  module          String
  title           String
  summary         String?
  actionUrl       String    @map("action_url")
  entityId        String?   @map("entity_id")
  entityType      String?   @map("entity_type")
  status          String    @default("PENDING")
  priority        String    @default("NORMAL")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  @@index([orgId, userId, status])
  @@map("simo_notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHIELD MODELS — These models exist to prevent Prisma db push from dropping
// tables that the application queries via the Supabase JS client.
// DO NOT REMOVE — they are the "armor" against destructive migrations.
// ─────────────────────────────────────────────────────────────────────────────

model DimTenant {
  tcode             String   @id
  legalName         String   @map("legal_name")
  dbaName           String   @map("dba_name")
  reportingCurrency String   @map("reporting_currency")
  status            Boolean  @default(true)
  hqAddress         Json?    @map("hq_address")
  pocs              Json?
  accountManagers   Json?    @map("account_managers")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("dim_tenant")
}

model DimEmployee {
  eid                    String   @id
  tenantId               String?  @map("tenant_id")
  numeroIdentificacion   String   @map("numero_identificacion")
  tipoDocumentoId        String   @map("tipo_documento_id")
  primerNombre           String   @map("primer_nombre")
  otrosNombres           String?  @map("otros_nombres")
  primerApellido         String   @map("primer_apellido")
  segundoApellido        String   @map("segundo_apellido")
  fechaNacimiento        DateTime @map("fecha_nacimiento") @db.Date
  genero                 String   @db.VarChar(1)
  emailPersonal          String   @map("email_personal")
  municipioDane          String   @map("municipio_dane")
  direccionResidencia    String   @map("direccion_residencia")
  fotoUrl                String?  @map("foto_url")
  status                 String?  @default("Active")
  emailCorporativo       String?  @map("email_corporativo")
  fechaInicio            DateTime @map("fecha_inicio") @db.Date
  fechaFin               DateTime? @map("fecha_fin") @db.Date
  tipoContrato           String   @map("tipo_contrato")
  tipoSalario            String   @map("tipo_salario")
  salarioBase            Decimal  @map("salario_base")
  procedimientoRenta     Int?     @default(1) @map("procedimiento_renta")
  area                   String
  subArea                String   @map("sub_area")
  centroCosto            String   @map("centro_costo")
  nombreCentroCosto      String?  @map("nombre_centro_costo")
  subCentroCosto         String?  @map("sub_centro_costo")
  nombreSubCentroCosto   String?  @map("nombre_sub_centro_costo")
  branch                 String?  @map("branch")
  cliente                String?  @map("cliente")
  project                String?  @map("project")
  digitoDedicacion       Int?     @map("digito_dedicacion")
  directLeader           String?  @map("direct_leader")
  directLeaderId         String?  @map("direct_leader_id")
  entidadLegal           String?  @map("entidad_legal")
  salaryCurrency         String?  @map("salary_currency")
  jobTitle               String?  @map("job_title")
  roleTitle              String?  @map("role_title")
  jobTitleId             String?  @map("job_title_id") @db.Uuid
  roleTitleId            String?  @map("role_title_id") @db.Uuid
  assignedBranchCode     String?  @map("assigned_branch_code")
  afiliaciones           Json?    @default("{}")
  sst                    Json?    @default("{}")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([status])
  @@map("dim_employee")
}

model DimJobTitle {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @map("tenant_id") @db.VarChar(15)
  title           String   @db.VarChar(255)
  area            String?  @db.VarChar(100)
  subArea         String?  @map("sub_area") @db.VarChar(100)
  costCenter      String?  @map("cost_center") @db.VarChar(20)
  status          String   @default("Draft") @db.VarChar(20)
  requesterId     String?  @map("requester_id") @db.VarChar(15)
  approver1Id     String?  @map("approver1_id") @db.VarChar(15)
  approver1Status String   @default("Pending") @map("approver1_status") @db.VarChar(20)
  approver2Id     String?  @map("approver2_id") @db.VarChar(15)
  approver2Status String   @default("Pending") @map("approver2_status") @db.VarChar(20)
  jdfData         Json?    @default("{}") @map("jdf_data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, title])
  @@index([tenantId])
  @@index([status])
  @@map("dim_job_title")
}

model DimRoleTitle {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.VarChar(15)
  jobTitleId  String?  @map("job_title_id") @db.Uuid
  roleTitle   String   @map("role_title") @db.VarChar(60)
  describeRole String? @map("describe_role") @db.VarChar(500)
  status      String   @default("Active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([jobTitleId, roleTitle])
  @@index([tenantId])
  @@index([jobTitleId])
  @@map("dim_role_title")
}

model DimExternalRole {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id")
  name          String   @db.VarChar(50)
  businessType  String?  @map("business_type")
  size          String?
  annualVolume  String?  @map("annual_volume")
  numAgents     String?  @map("num_agents")
  notes         String?
  status        String   @default("Active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([orgId, name])
  @@index([orgId, status])
  @@map("dim_external_role")
}

model DimBranch {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.VarChar(20)
  branchCode         String   @map("branch_code") @db.VarChar(20)
  branchName         String?  @map("branch_name") @db.VarChar(255)
  branchManagerEid   String?  @map("branch_manager_eid") @db.VarChar(20)
  statesLicensed     String[] @default([]) @map("states_licensed")
  fieldOfficeType    String   @default("Physical") @map("field_office_type")
  officeAddress      String?  @map("office_address")
