# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Next.js ──────────────────────────────────────────────────────────────────
/.next/
/out/
/build/

# ─── Node Modules ─────────────────────────────────────────────────────────────
/node_modules/
/.pnp
.pnp.js

# ─── Environment Variables ────────────────────────────────────────────────────
# CRITICAL: These files contain secrets and must NEVER be committed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing ──────────────────────────────────────────────────────────────────
/coverage/

# ─── Build Artifacts ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / Editor Files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── Error Reports ────────────────────────────────────────────────────────────
ts_errors.txt
ts_errors_utf8.txt

# ─── Supabase Local Dev (if used) ─────────────────────────────────────────────
.branches
.temp
supabase/.temp/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# ─── Diagnóstico ──────────────────────────────────────────────────────────────
tmp_*.js
query*.sql
